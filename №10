print('Введите количество секунд с момента старта:')
s = int(input())
m = 0
h = 0
print(f'Время с момента старта: {s} секунд.')
if s >= 60:
  if s >= 3600:
    h = s // 3600
    s = s - h * 3600
    m = s // 60
    s = s - m * 60
  else:
    m = s // 60
    s = s - m * 60
print(f'Форматированное время: {h} ч {m} мин {s} сек.')
